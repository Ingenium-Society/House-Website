# ---- Frontend (Vite / Node / TypeScript) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Backend (Python / FastAPI) ----
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/.venv/
backend/venv/
backend/env/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# ---- Environment variables & secrets (never commit these) ----
.env
.env.local
.env.*.local
frontend/.env
backend/.env
*.pem
*.key

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs & coverage ----
*.log
coverage/
htmlcov/
.coverage

# Note: .devcontainer/ is intentionally NOT ignored — it must be committed
# so Codespaces can build the same environment for everyone.
